---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const dateStr = data.date.toLocaleDateString('ru-RU', {
  day: '2-digit', month: 'long', year: 'numeric',
});
---

<Base title={`${data.title} — Никита Смирнов`} description={data.description}>
  <section>
    <div class="container">
      <a href="/projects" class="mono back-link">← Все проекты</a>

      <div class="proj-head" data-reveal>
        <div class="proj-meta">
          {data.week != null && <span class="card-week" style="position:static">НЕДЕЛЯ {String(data.week).padStart(2,'0')}</span>}
          <span class="mono" style="color:var(--text-dim)">{dateStr}</span>
        </div>
        <h1>{data.title}</h1>
        <p class="proj-lead">{data.description}</p>

        <div class="card-tags" style="margin:20px 0 26px">
          {data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>

        <div class="proj-actions">
          {data.tryUrl && (
            <a class="btn btn-primary" href={data.tryUrl} target="_blank" rel="noopener">Попробовать →</a>
          )}
          {data.githubUrl && (
            <a class="btn" href={data.githubUrl} target="_blank" rel="noopener">Исходники на GitHub</a>
          )}
          {!data.tryUrl && !data.githubUrl && (
            <span class="mono" style="color:var(--text-dim)">Ссылка скоро появится</span>
          )}
        </div>
      </div>

      {data.cover && (
        <div class="proj-cover" data-reveal>
          <Image src={data.cover} alt={data.title} width={1120} height={630} />
        </div>
      )}

      <article class="prose" data-reveal style="margin-top:44px">
        <Content />
      </article>
    </div>
  </section>
</Base>

<style>
  .back-link { color: var(--text-dim); transition: color 0.2s; display: inline-block; margin-bottom: 34px; }
  .back-link:hover { color: var(--violet-bright); }
  .proj-meta { display: flex; align-items: center; gap: 16px; margin-bottom: 18px; }
  .proj-head h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .proj-lead { font-size: 1.2rem; color: var(--text-2); max-width: 60ch; margin-top: 14px; }
  .proj-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .proj-cover {
    margin-top: 40px; border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; box-shadow: 0 30px 80px -50px var(--glow);
  }
  .proj-cover img { width: 100%; height: auto; display: block; }
</style>

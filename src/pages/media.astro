---
import Base from '../layouts/Base.astro';

const media = [
  {
    idx: '01',
    title: 'Подкаст «Путь Человеческий»',
    text: 'Разговоры о жизни, бизнесе и внутреннем пути. 15+ выпусков как ведущий.',
    link: 'https://www.youtube.com/@путь-человеческий',
    linkLabel: 'Смотреть на YouTube →',
  },
  {
    idx: '02',
    title: 'Книги',
    text: 'Мои книги и тексты. Ссылки и описания добавим.',
    link: '',
    linkLabel: '',
  },
  {
    idx: '03',
    title: 'Настольная игра',
    text: 'Авторская настольная игра. Описание и материалы добавим.',
    link: '',
    linkLabel: '',
  },
  {
    idx: '04',
    title: 'СМИ-журнал «Конвейер»',
    text: 'Издавал журнал «Конвейер»: есть видео на YouTube и электронная версия.',
    link: '',
    linkLabel: 'Видео + журнал (добавим ссылки)',
  },
];
---

<Base title="Медиа — Никита Смирнов" description="Подкаст, книги, настольная игра и прошлые проекты Никиты Смирнова.">
  <section>
    <div class="container">
      <p class="eyebrow" data-reveal>MEDIA · ТВОРЧЕСТВО</p>
      <div class="section-head" data-reveal style="margin-top:20px">
        <h2>Что сделал</h2>
      </div>
      <p class="prose" data-reveal style="margin-bottom:38px; color:var(--text-2)">
        Не только код. Подкаст, тексты, игра и прошлые проекты — то, что складывается
        в объём личности.
      </p>

      <div class="media-grid" data-reveal>
        {media.map((m) => (
          <div class="media-item">
            <span class="idx mono">{m.idx}</span>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
            {m.link ? (
              <a class="btn" href={m.link} target="_blank" rel="noopener">{m.linkLabel}</a>
            ) : m.linkLabel ? (
              <span class="mono" style="color:var(--text-dim); font-size:0.8rem">{m.linkLabel}</span>
            ) : null}
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

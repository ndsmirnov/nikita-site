---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latest = projects.slice(0, 3);
const total = projects.length;

const stack = ['Python', 'Claude', 'Telegram', 'Whisper', 'Groq', 'Astro', 'Google Sheets', 'SQLite', 'Netlify'];
---

<Base>
  <!-- ПОЛНОЭКРАННЫЙ HERO -->
  <section class="hero">
    <canvas id="net" class="hero-net"></canvas>
    <div class="hero-veil"></div>

    <div class="container hero-inner">
      <p class="eyebrow" data-reveal>AI ENGINEER · СИСТЕМЫ И БОТЫ</p>

      <h1 class="hero-title" data-reveal>
        Строю <span class="grad-text">AI-инструменты</span>,<br />
        которые снимают рутину —<br />
        и запускаю <span class="rotator" data-rotator>боты</span>
      </h1>

      <p class="hero-sub" data-reveal>
        Меня зовут Никита Смирнов. Голосовые ассистенты, Telegram-боты и
        автоматизации, которые возвращают людям время. Новый рабочий продукт —
        каждую неделю. Здесь живая витрина всего, что я строю.
      </p>

      <div class="hero-actions" data-reveal>
        <a class="btn btn-primary" href="/projects">Смотреть проекты →</a>
        <a class="btn btn-ghost" href="/about">Моя история</a>
      </div>

      <div class="hero-stats" data-reveal>
        <div class="stat"><span class="num grad-text">{String(total).padStart(2, '0')}</span><span class="lbl mono">проектов в витрине</span></div>
        <div class="stat"><span class="num grad-text">2022</span><span class="lbl mono">в AI с этого года</span></div>
        <div class="stat"><span class="num grad-text">1/нед</span><span class="lbl mono">новый деплой</span></div>
      </div>
    </div>

    <div class="scroll-hint mono">SCROLL ↓</div>
  </section>

  <!-- БЕГУЩАЯ СТРОКА СТЕКА -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span class="marquee-item">{stack.join(' ')}</span>
      <span class="marquee-item">{stack.join(' ')}</span>
    </div>
  </div>

  <!-- ПОСЛЕДНИЕ ПРОЕКТЫ -->
  <section data-reveal>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">WORKS · 01</span>
        <h2>Последние деплои</h2>
      </div>
      {latest.length > 0 ? (
        <div class="grid">
          {latest.map((p) => (
            <ProjectCard slug={p.id} title={p.data.title} description={p.data.description} tags={p.data.tags} week={p.data.week} cover={p.data.cover} />
          ))}
        </div>
      ) : (
        <p class="mono" style="color:var(--text-dim)">Скоро здесь появятся проекты.</p>
      )}
      <div style="margin-top:36px"><a class="btn" href="/projects">Все проекты →</a></div>
    </div>
  </section>

  <!-- ВХОДЫ В РАЗДЕЛЫ -->
  <section data-reveal>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">NAVIGATE · 02</span>
        <h2>Куда дальше</h2>
      </div>
      <div class="nav-cards">
        <a class="nav-card" href="/about"><span class="idx mono">01</span><h3>Обо мне</h3><p>Путь с 2022-го, история и философия. Кто я и почему делаю то, что делаю.</p></a>
        <a class="nav-card" href="/media"><span class="idx mono">02</span><h3>Медиа</h3><p>Подкаст «Путь Человеческий», книги, настольная игра и прошлые проекты.</p></a>
        <a class="nav-card" href="/contact"><span class="idx mono">03</span><h3>Контакт</h3><p>Связаться напрямую в Telegram. Обсудить задачу или просто написать.</p></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: 100svh; display: flex; align-items: center;
    position: relative; overflow: hidden; padding: 90px 0 60px;
  }
  .hero-net { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
  .hero-veil {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      radial-gradient(60vw 60vh at 75% 35%, rgba(168,85,247,0.16), transparent 60%),
      radial-gradient(50vw 40vh at 15% 80%, rgba(56,189,248,0.12), transparent 60%),
      linear-gradient(180deg, transparent 60%, var(--bg) 100%);
  }
  .hero-inner { position: relative; z-index: 2; }

  .hero-title { font-size: clamp(2.3rem, 6vw, 4.4rem); margin: 26px 0 26px; max-width: 20ch; }
  .grad-text { text-shadow: 0 0 44px var(--glow); }
  .rotator { color: var(--cyan); text-shadow: 0 0 30px var(--glow-cyan); }

  .hero-sub { max-width: 58ch; color: var(--text-2); font-size: 1.12rem; }
  .hero-actions { display: flex; gap: 14px; margin-top: 34px; flex-wrap: wrap; }

  .hero-stats { display: flex; gap: 48px; margin-top: 60px; flex-wrap: wrap; }
  .stat { display: flex; flex-direction: column; gap: 6px; }
  .stat .num { font-size: 2.1rem; font-weight: 700; line-height: 1; font-family: var(--font-display); }
  .stat .lbl { font-size: 0.72rem; letter-spacing: 0.06em; color: var(--text-dim); text-transform: uppercase; }

  .scroll-hint {
    position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 2;
    font-size: 0.7rem; letter-spacing: 0.3em; color: var(--text-dim);
    animation: bob 2s ease-in-out infinite;
  }
  @keyframes bob { 0%,100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(6px); } }

  .nav-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  .nav-card {
    border: 1px solid var(--line); border-radius: var(--radius); padding: 30px;
    background: linear-gradient(180deg, var(--bg-card), var(--bg-2)); transition: all 0.35s var(--ease);
  }
  .nav-card:hover { border-color: var(--violet); transform: translateY(-4px); box-shadow: 0 24px 60px -34px var(--glow); }
  .nav-card .idx { color: var(--cyan); font-size: 0.85rem; letter-spacing: 0.1em; }
  .nav-card h3 { font-size: 1.4rem; margin: 12px 0 8px; }
  .nav-card p { color: var(--text-2); font-size: 0.95rem; }

  @media (prefers-reduced-motion: reduce) { .scroll-hint { animation: none; } }
</style>

<script>
  // === ротатор ключевых слов ===
  const rot = document.querySelector<HTMLElement>('[data-rotator]');
  if (rot) {
    const words = ['боты', 'ассистентов', 'автоматизации', 'воронки', 'инструменты'];
    let i = 0;
    setInterval(() => {
      rot.style.opacity = '0';
      rot.style.transform = 'translateY(8px)';
      setTimeout(() => {
        i = (i + 1) % words.length;
        rot.textContent = words[i];
        rot.style.opacity = '1';
        rot.style.transform = 'none';
      }, 260);
    }, 2200);
    rot.style.transition = 'opacity 0.26s ease, transform 0.26s ease';
    rot.style.display = 'inline-block';
  }

  // === нейросеть-частицы на hero ===
  const canvas = document.getElementById('net') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas && !reduce) {
    const ctx = canvas.getContext('2d')!;
    let w = 0, h = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
    const mouse = { x: -9999, y: -9999 };
    type P = { x: number; y: number; vx: number; vy: number };
    let pts: P[] = [];

    function resize() {
      const r = canvas!.getBoundingClientRect();
      w = r.width; h = r.height;
      canvas!.width = w * dpr; canvas!.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(90, Math.floor((w * h) / 16000));
      pts = Array.from({ length: count }, () => ({
        x: Math.random() * w, y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.4, vy: (Math.random() - 0.5) * 0.4,
      }));
    }

    function tick() {
      ctx.clearRect(0, 0, w, h);
      for (const p of pts) {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;
      }
      // связи
      for (let a = 0; a < pts.length; a++) {
        for (let b = a + 1; b < pts.length; b++) {
          const dx = pts[a].x - pts[b].x, dy = pts[a].y - pts[b].y;
          const d = Math.hypot(dx, dy);
          if (d < 130) {
            const o = (1 - d / 130) * 0.5;
            ctx.strokeStyle = `rgba(168,85,247,${o})`;
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(pts[a].x, pts[a].y); ctx.lineTo(pts[b].x, pts[b].y); ctx.stroke();
          }
        }
      }
      // узлы + подсветка от курсора
      for (const p of pts) {
        const dm = Math.hypot(p.x - mouse.x, p.y - mouse.y);
        const near = dm < 140;
        ctx.fillStyle = near ? 'rgba(56,189,248,0.95)' : 'rgba(196,160,255,0.65)';
        ctx.beginPath(); ctx.arc(p.x, p.y, near ? 2.6 : 1.6, 0, Math.PI * 2); ctx.fill();
        if (near) {
          ctx.strokeStyle = `rgba(56,189,248,${(1 - dm / 140) * 0.5})`;
          ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke();
        }
      }
      raf = requestAnimationFrame(tick);
    }

    let raf = 0;
    canvas.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    });
    canvas.addEventListener('pointerleave', () => { mouse.x = -9999; mouse.y = -9999; });
    window.addEventListener('resize', resize);
    // пауза, когда hero не виден
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (!raf) raf = requestAnimationFrame(tick); }
      else { cancelAnimationFrame(raf); raf = 0; }
    });
    resize(); io.observe(canvas);
  }
</script>

---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import LeadForm from './LeadForm.astro';
import { DICTS, LINKS, TOOLS, EPISODES, SOC_PREVIEW } from '../data/content';
import { telegramPosts } from '../lib/feeds';

interface Props { lang: 'ru' | 'en' }
const t = DICTS[Astro.props.lang];
const posts = await telegramPosts('put_chelovecheskiy', 6);
const fmt = (d: string) =>
  new Date(d).toLocaleDateString(t.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });
const ready = TOOLS.filter((x) => x.ready);
const soon = TOOLS.filter((x) => !x.ready);
const toolText = t.tools.items as Record<string, { title: string; tag: string; text: string; needs?: string }>;
const words = (s: string) => s.split(' ');

const ICONS: Record<string, { color: string; svg: string }> = {
  channel: { color: '#17803F', svg: '<path fill="currentColor" d="M21.5 3.6 2.9 10.8c-1.3.5-1.3 1.2-.2 1.6l4.8 1.5 1.8 5.6c.2.6.1.9.8.9.5 0 .7-.2 1-.5l2.3-2.3 4.9 3.6c.9.5 1.5.2 1.8-.8l3.2-15.1c.3-1.3-.5-1.9-1.8-1.3ZM8.3 13.6l10.4-6.6c.5-.3.9-.1.6.2l-8.9 8-.3 3.7-1.8-5.3Z"/>' },
  bot: { color: '#1D1A16', svg: '<path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 3v3M5 8h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2Z"/><circle cx="9" cy="13" r="1.6" fill="currentColor"/><circle cx="15" cy="13" r="1.6" fill="currentColor"/>' },
  instagram: { color: '#C2566F', svg: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>' },
  podcast: { color: '#C46F22', svg: '<rect x="9" y="2.5" width="6" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M8.5 21h7"/>' },
  youtube: { color: '#B5402F', svg: '<path fill="currentColor" d="M22 8.2a3 3 0 0 0-2.1-2.1C18 5.6 12 5.6 12 5.6s-6 0-7.9.5A3 3 0 0 0 2 8.2 31 31 0 0 0 1.6 12 31 31 0 0 0 2 15.8a3 3 0 0 0 2.1 2.1c1.9.5 7.9.5 7.9.5s6 0 7.9-.5a3 3 0 0 0 2.1-2.1c.4-1.2.4-3.8.4-3.8s0-2.6-.4-3.8ZM10 15.1V8.9l5.2 3.1L10 15.1Z"/>' },
  github: { color: '#3a342c', svg: '<path fill="currentColor" d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"/>' },
};
---
<Base t={t}>
  <Header t={t} />

  <main>
    <!-- Первый экран: оффер + два действия -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <h1 class="split">
            {words(t.hero.title).map((w, i) => <span class="w"><span style={`--i:${i}`}>{w}</span></span>)}
            <span class="accent">{words(t.hero.accent).map((w, i) => <span class="w"><span style={`--i:${i + 4}`}>{w}</span></span>)}</span>
          </h1>
          <p class="lead">{t.hero.lead}</p>
          <div class="hero-cta">
            <a class="btn btn-primary magnet" href="#contact"><span class="arrow">{t.hero.cta}</span></a>
            <a class="btn btn-ghost magnet" href="#tools">{t.hero.cta2}</a>
          </div>
          <p class="free-note"><span class="dot"></span>{t.hero.free}</p>
        </div>
        <div class="hero-photo tilt">
          <div class="polaroid">
            <button class="clip-btn" type="button" aria-label="скрепка"><img class="clip" src="/img/clip.png" alt="" width="200" height="133" /></button>
            <img src="/img/hero.webp" alt={t.hero.photoAlt} width="900" height="1125" fetchpriority="high" />
            <div class="cap hand">{t.hero.motto}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Бегущая строка стека -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[...t.stack, ...t.stack].map((s) => <span>{s}</span>)}
      </div>
    </div>

    <!-- Что уже работает: интерактивное «окно» -->
    <div class="proof">
      <div class="wrap">
        <div class="proof-box reveal" data-proof>
          <div class="proof-label"><span class="dot"></span>{t.proof.label}<span class="proof-hint">{t.proof.hint}</span></div>
          <div class="proof-grid">
            <div class="proof-list" role="tablist">
              {t.proof.items.map((i, n) => (
                <button class={`proof-item${n === 0 ? ' on' : ''}`} type="button" role="tab" aria-selected={n === 0 ? 'true' : 'false'} data-i={n}>
                  <span class="pi-num">0{n + 1}</span>
                  <span class="pi-text"><b>{i.t}</b><span>{i.d}</span></span>
                  <span class="pi-bar"><i></i></span>
                </button>
              ))}
            </div>
            <div class="proof-window">
              <div class="win-bar"><i></i><i></i><i></i><span>~/kontorka</span></div>
              <div class="win-body">
                {t.proof.items.map((i, n) => (
                  <figure class={`win-shot${n === 0 ? ' on' : ''}`} data-i={n}>
                    <div class="win-media">
                      {i.video
                        ? <video src={i.video} poster={i.img} muted loop playsinline preload={n === 0 ? 'auto' : 'none'} aria-label={i.t}></video>
                        : <img src={i.img} alt={i.t} loading="lazy" />}
                      {i.demo && <span class="win-demo">{t.proof.demoNote}</span>}
                    </div>
                    <figcaption>
                      <span class="fc-stat"><b class="count" data-to={i.stat}>{i.stat}</b>{i.plus ? '+' : ''}<span>{i.statLabel}</span></span>
                      {i.logos && (
                        <span class="plat" aria-label="Instagram, YouTube Shorts, Threads, TikTok">
                          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg>
                          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4" fill="currentColor"/><path d="M10 9l5 3-5 3z" fill="#0f0d0b"/></svg>
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.6 11.2c-.1 0-.2-.1-.3-.1-.2-2.9-1.8-4.6-4.4-4.6-1.6 0-2.9.7-3.7 1.9l1.4 1c.6-.9 1.5-1.1 2.3-1.1 1.6 0 2.4 1 2.6 2.3-.6-.1-1.3-.2-2-.2-2.3 0-3.9 1.2-3.9 3.1 0 1.8 1.5 3 3.4 3 2 0 3.3-1.2 3.8-3 .9.5 1.4 1.3 1.4 2.4 0 1.9-1.8 3.6-5.3 3.6-4 0-6-2.5-6-7.4s2-7.4 6-7.4c3.6 0 5.5 2 6.1 5.2l1.7-.4C19.3 4.9 16.8 2.5 12 2.5 6.9 2.5 4.3 5.9 4.3 12s2.6 9.5 7.7 9.5c4.4 0 7.1-2.3 7.1-5.4 0-2.3-1.1-3.9-2.5-4.9zm-4.4 4.2c-1 0-1.6-.5-1.6-1.2 0-.9.9-1.4 2.2-1.4.5 0 1 .1 1.4.1-.3 1.6-1 2.5-2 2.5z" fill="currentColor"/></svg>
                          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 3c.4 2.2 1.8 3.6 4 3.8v3.1c-1.5 0-2.8-.4-4-1.2v6.1c0 3.4-2.6 5.7-5.7 5.7S5 18.2 5 15.1c0-3.3 2.8-5.9 6.4-5.5v3.2c-1.5-.4-3.2.6-3.2 2.3 0 1.3 1 2.4 2.5 2.4s2.6-1 2.6-2.8V3z" fill="currentColor"/></svg>
                        </span>
                      )}
                      {i.banks && <span class="banks"><em>{t.proof.banksLabel}</em>{i.banks.map((b) => <span>{b}</span>)}</span>}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          </div>
          <div class="proof-offer">
            <div><b>{t.proof.offer.title}</b><p>{t.proof.offer.text}</p></div>
            <a class="btn btn-primary magnet" href="#contact"><span class="arrow">{t.proof.offer.cta}</span></a>
          </div>
        </div>
      </div>
    </div>

    <!-- С чем приходят + процесс -->
    <section id="consult" class="alt">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="kicker">{t.services.kicker}</div>
          <h2>{t.services.title}</h2>
          <p class="lead">{t.services.lead}</p>
        </div>
        <div class="svc-grid">
          {t.services.groups.map((g) => (
            <div class={`svc reveal ${g.tone}`}>
              <span class={`tag ${g.tone}`}>{g.tag}</span>
              <h3>{g.title}</h3>
              <ul>{g.items.map(([pain, fix]) => <li><q>{pain.replace(/[«»“”]/g, '')}</q><span>{fix}</span></li>)}</ul>
            </div>
          ))}
        </div>
        <div class="steps reveal" data-steps>
          <h3>{t.services.steps.title}</h3>
          <ol>
            {t.services.steps.items.map(([a, b], i) => <li style={`--i:${i}`}><b>{a}</b><span>{b}</span></li>)}
          </ol>
          <div class="steps-cta">
            <a class="btn btn-primary magnet" href="#contact"><span class="arrow">{t.services.cta}</span></a>
            <span class="free-note"><span class="dot"></span>{t.hero.free}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Инструменты -->
    <section id="tools">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="kicker">{t.tools.kicker}</div>
          <h2>{t.tools.title}</h2>
          <p class="lead">{t.tools.lead}</p>
        </div>
        <div class="tools-grid">
          {ready.map((x, i) => {
            const d = toolText[x.key];
            return (
              <article class="tool reveal spot" style={`--d:${i * 90}ms`}>
                <div class="ph">
                  <img src={x.img} alt={d.title} loading="lazy" width="1000" height="563" />
                  <span class="tag">{d.tag}</span>
                </div>
                <div class="body">
                  <h3>{d.title}</h3>
                  <p>{d.text}</p>
                  {d.needs && <div class="needs">{d.needs.split(' · ').map((n) => <span>{n}</span>)}</div>}
                  <div class="acts">
                    <a class="btn btn-primary btn-sm" href={`${LINKS.bot}?start=${x.key}`} target="_blank" rel="noopener"><span class="arrow">{t.tools.get}</span></a>
                    {x.repo && <a class="btn btn-ghost btn-sm" href={x.repo} target="_blank" rel="noopener">{t.tools.code}</a>}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
        <div class="soon-row">
          {soon.map((x) => {
            const d = toolText[x.key];
            return (
              <div class="soon reveal">
                <span class="tag muted">{t.tools.soon}</span>
                <div><h3>{d.title}</h3><p>{d.text} {t.tools.soonNote}</p></div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Системы: было / стало -->
    <section id="systems" class="alt">
      <div class="wrap">
        <div class="sec-head row reveal">
          <div>
            <div class="kicker">{t.cases.kicker}</div>
            <h2>{t.cases.title}</h2>
            <p class="lead">{t.cases.lead}</p>
          </div>
        </div>
        <div class="sys-grid">
          {t.cases.items.map((c) => (
            <article class="sys reveal" data-ba="after">
              <div class={`sys-shot${c.img ? ' has-img' : ''}`}>
                {c.img && <img src={c.img} alt={c.t} loading="lazy" />}
                <div class="res-metric"><b>{c.metric}</b><span>{c.metricLabel}</span></div>
              </div>
              <div class="sys-body">
                <div class="sys-top">
                  <h3>{c.t}</h3>
                  <div class="ba" role="group">
                    <button type="button" data-v="before">{t.cases.before}</button>
                    <button type="button" data-v="after" class="on">{t.cases.after}</button>
                  </div>
                </div>
                <p class="ba-text before">{c.was}</p>
                <p class="ba-text after">{c.now}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Подкаст -->
    <section id="podcast" class="podcast">
      <div class="wrap">
        <div class="podcast-grid">
          <div class="reveal">
            <div class="kicker">{t.podcast.kicker}</div>
            <h2>{t.podcast.title}</h2>
            <p class="lead">{t.podcast.lead}</p>
            <div class="pod-stats">
              {t.podcast.stats.map(([n, l]) => <div><b>{n}</b><span>{l}</span></div>)}
            </div>
            <div class="podcast-cta">
              <a class="btn btn-gold magnet" href={t.podPath}><span class="arrow">{t.podcast.kit}</span></a>
              <a class="btn btn-ghost" href={LINKS.podcast} target="_blank" rel="noopener">{t.podcast.watch}</a>
            </div>
          </div>
          <div class="podcast-photo reveal">
            <img src="/img/pod/studio-guests.webp" alt={t.podcast.imgAlt} loading="lazy" width="1600" height="900" />
            <div class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
          </div>
        </div>
        <div class="pod-cases">
          {t.podcast.cases.map((c, i) => (
            <a class="pod-case reveal" href={`${t.podPath}#${c.key}`} style={`--d:${i * 90}ms`}>
              <img src={EPISODES[c.key].img} alt="" loading="lazy" width="640" height="360" />
              <div><span class="hook">{c.hook}</span><b>{c.name}</b><small>{c.line}</small></div>
            </a>
          ))}
        </div>
        <p class="pod-guest"><a href="#contact">{t.podcast.guest}</a></p>
      </div>
    </section>

    <!-- Блог: лента канала -->
    <section id="blog">
      <div class="wrap">
        <div class="sec-head row reveal">
          <div>
            <div class="kicker">{t.blog.kicker}</div>
            <h2>{t.blog.title}</h2>
            <p class="lead">{t.blog.lead}</p>
          </div>
          <a class="btn btn-ghost" href={LINKS.channel} target="_blank" rel="noopener"><span class="arrow">{t.blog.all}</span></a>
        </div>
        {posts.length > 0 ? (
          <div class="posts">
            {posts.map((x) => (
              <a class="post reveal" href={x.url} target="_blank" rel="noopener">
                {x.image && (
                  <div class="post-ph" style={`--bg:url('${x.image}')`}>
                    <img src={x.image} alt="" loading="lazy" referrerpolicy="no-referrer" />
                  </div>
                )}
                <div class="pb">
                  <time datetime={x.date}>{fmt(x.date)}</time>
                  <h3>{x.title.replace(/[.\s]+$/, "")}</h3>
                  <p>{x.excerpt}</p>
                  <span class="more arrow">{t.blog.read} </span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty">{t.blog.empty} <a class="textlink" href={LINKS.channel}>t.me/put_chelovecheskiy</a></div>
        )}
      </div>
    </section>

    <!-- Мой путь -->
    <section id="about" class="alt">
      <div class="wrap about-grid">
        <div class="about-photo reveal tilt">
          <div class="polaroid">
            <img class="clip" src="/img/clip.png" alt="" width="200" height="133" />
            <img src="/img/about-live.webp" alt={t.lang === 'ru' ? 'Никита Смирнов' : 'Nikita Smirnov'} loading="lazy" width="800" height="1000" />
            <div class="cap hand">{t.about.note}</div>
          </div>
        </div>
        <div class="about-text">
          <div class="reveal">
            <div class="kicker">{t.about.kicker}</div>
            <h2>{t.about.title}</h2>
            <div class="about-lead">{t.about.lead.map((x) => <p>{x}</p>)}</div>
          </div>
          <div class="timeline">
            {t.about.timeline.map((p, i) => (
              <details class="tl reveal" open={i === t.about.timeline.length - 1}>
                <summary>
                  <span class="y">{p.y}</span>
                  <b>{p.t}</b>
                  <span class="s">{p.s}</span>
                  <span class="tl-toggle" aria-hidden="true"></span>
                </summary>
                <div class="tl-body">
                  <ul>{p.items.map((x) => <li>{x}</li>)}</ul>
                  {p.img && <img src={p.img} alt="" loading="lazy" />}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Соцсети -->
    <section>
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="kicker">{t.socials.kicker}</div>
          <h2>{t.socials.title}</h2>
        </div>
        <div class="socials">
          {t.socials.items.map((s, i) => (
            <a class="soc reveal" href={LINKS[s.key as keyof typeof LINKS]} target="_blank" rel="noopener" style={`--d:${i * 70}ms`}>
              <span class="ic" style={`background:${ICONS[s.key].color}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[s.key].svg} />
              </span>
              <span><b>{s.name}</b><span class="h">{s.handle}</span><small>{s.d}</small></span>
              <span class="soc-pop" aria-hidden="true"><img src={SOC_PREVIEW[s.key]} alt="" loading="lazy" width="560" height="350" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="alt">
      <div class="wrap">
        <div class="sec-head reveal"><h2>{t.faq.title}</h2></div>
        <div class="faq reveal">
          {t.faq.items.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </div>
    </section>

    <!-- Заявка -->
    <section id="contact" class="contact">
      <div class="wrap contact-grid">
        <div class="reveal">
          <div class="kicker">{t.contact.kicker}</div>
          <h2>{t.contact.title}</h2>
          <p class="lead">{t.contact.lead}</p>
          <p class="free-note light"><span class="dot"></span>{t.contact.free}</p>
          <div class="direct">
            <span>{t.contact.direct}</span>
            <a class="textlink" href={LINKS.dm} target="_blank" rel="noopener">t.me/poetsmirnov</a>
          </div>
        </div>
        <div class="reveal"><LeadForm t={t} /></div>
      </div>
    </section>
  </main>

  <Footer t={t} alt={t.altPath} />
</Base>

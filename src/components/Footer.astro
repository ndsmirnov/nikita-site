---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div>
      <div class="nav-logo" style="margin-bottom:14px">
        <span class="mark">NS</span>
        <span>НИКИТА СМИРНОВ</span>
      </div>
      <p class="mono">AI-автоматизация · боты · инструменты</p>
    </div>

    <div style="display:flex; gap:56px; flex-wrap:wrap">
      <div>
        <p class="mono" style="margin-bottom:12px; color:var(--violet-bright)">РАЗДЕЛЫ</p>
        <div style="display:flex; flex-direction:column; gap:8px">
          <a href="/projects">Проекты</a>
          <a href="/about">Обо мне</a>
          <a href="/media">Медиа</a>
          <a href="/contact">Контакт</a>
        </div>
      </div>
      <div>
        <p class="mono" style="margin-bottom:12px; color:var(--violet-bright)">СВЯЗЬ</p>
        <div style="display:flex; flex-direction:column; gap:8px">
          <a href="https://t.me/ndsmirnov" target="_blank" rel="noopener">Telegram</a>
        </div>
      </div>
    </div>
  </div>
  <div class="container" style="margin-top:40px">
    <p class="mono" style="font-size:0.72rem; color:var(--text-dim)">© {year} · Собрано на Astro · в AI с 2022</p>
  </div>
</footer>

---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const links = [
  { href: '/projects', label: 'ПРОЕКТЫ' },
  { href: '/about', label: 'ОБО МНЕ' },
  { href: '/media', label: 'МЕДИА' },
  { href: '/contact', label: 'КОНТАКТ' },
];
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="На главную">
      <span class="mark jp">士</span>
      <span>НИКИТА СМИРНОВ</span>
    </a>

    <button class="nav-burger" aria-label="Меню" data-burger>
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <div class="nav-links" data-menu>
      {links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>
  </div>
</nav>

<script>
  const burger = document.querySelector('[data-burger]');
  const menu = document.querySelector('[data-menu]');
  burger?.addEventListener('click', () => menu?.classList.toggle('open'));
</script>
